// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FALTA CRIAR O MODEL DE CONSULTA, E TAMBÉM FALTA PENSAR NUM JEITO PROS HORÁRIOS
// FALTA RODAR OS COMANDOS TAMBEM


model User {
  id String @id @default(uuid())
  name String?
  email String @unique
  password_hash String 
  created_at DateTime @default(now())
  clinicas      Clinica[]
}

model Clinica {
  id String @id @default(uuid())
  name String
  contact String
  address String
  user_id String 
  user User @relation(fields: [user_id], references: [id])
  employees Employee[]
}

model Employee {
  id String @id @default(uuid())
  name String
  services Services[]
  clinica_id String
  clinica Clinica @relation(fields: [clinica_id], references: [id])
}

model Services {
  id String @id @default(uuid())
  name String
  description String?
  price Decimal
  employee_id String
  employee Employee @relation(fields: [employee_id], references: [id])
}