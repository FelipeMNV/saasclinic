// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// FALTA CRIAR O MODEL DE CONSULTA, E TAMBÉM FALTA PENSAR NUM JEITO PROS HORÁRIOS

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  plan      String    @default("FREE")
  role      Role      @default(USER)
  clinicas  Clinica[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Role {
  SUPERADMIN
  USER
  MANAGER
  EMPLOYEE
}

model Clinica {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  contact     String
  address     String
  isActive    Boolean       @default(true)
  user_id     String?
  user        User?         @relation(fields: [user_id], references: [id])
  employees   Employee[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  services    Service[]
  Appointment Appointment[]
}

model Employee {
  id          String        @id @default(uuid())
  name        String
  speciality  String
  email       String        @unique
  password    String
  role        Role          @default(EMPLOYEE)
  services    Service[]
  clinica_id  String?
  clinica     Clinica?      @relation(fields: [clinica_id], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Appointment Appointment[]
}

enum Type {
  INDIVIDUAL
  COLLECTIVE
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal
  duration    Int
  type        Type
  capacity    Int

  employee_id String?
  employee    Employee? @relation(fields: [employee_id], references: [id])

  clinica_id String
  clinica    Clinica @relation(fields: [clinica_id], references: [id])

  appointments   Appointment[]
  availabilities Availability[]
  blockedslots   BlockedSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Availability {
  id         String   @id @default(uuid())
  service_id String?
  service    Service? @relation(fields: [service_id], references: [id])

  dayOfWeek    Int // 0=domingo ... 6=sábado
  startTime    DateTime @db.Time
  endTime      DateTime @db.Time
  slotDuration Int // minutos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlockedSlot {
  id         String   @id @default(uuid())
  service_id String?
  service    Service? @relation(fields: [service_id], references: [id])

  date      DateTime
  startTime DateTime @db.Time
  endTime   DateTime @db.Time
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RETURN
  COMPLETED
  CANCELLED
}

model Appointment {
  id     String            @id @default(uuid())
  start  DateTime
  end    DateTime
  status AppointmentStatus @default(PENDING)

  customerName  String
  customerEmail String
  customerCPF   String
  customerPhone String

  service_id String?
  service    Service? @relation(fields: [service_id], references: [id])

  employee_id String?
  employee    Employee? @relation(fields: [employee_id], references: [id])

  clinica_id String?
  clinica    Clinica? @relation(fields: [clinica_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
